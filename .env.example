PORT=3000
DATA_DIR=./data          # SQLite db + uploads live here (mount a volume in production)
SEED_PASSWORD=fieldhub   # password for the demo accounts created on first boot
AUTO_SEED=1              # set to 0 to start with an empty database
TZ_PROJECT=America/Los_Angeles
DEMO_MODE=1              # one-click role sign-in on the login screen; set to 0 for real use
